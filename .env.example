# Credenciais dos bancos de dados. Copie para .env (que NÃO vai para o git) e troque os valores:
#   cp .env.example .env
#
# Quem lê o .env:
#   - docker compose: lê sozinho o .env da raiz do repositório
#   - ms-administrativo e ms-agendamento rodando fora do Docker (IDE ou mvn spring-boot:run): leem pelo
#     spring.config.import do application.yml
#
# Formato: CHAVE=valor, sem aspas e sem espaços ao redor do "=".
# O banco só cria o usuário na PRIMEIRA subida (volume vazio). Para trocar usuário ou senha de um banco que já
# existe, troque também dentro dele (ou recrie o volume com "docker compose down -v", que apaga os dados).

# PostgreSQL do ms-administrativo
ADMINISTRATIVO_DB_USER=troque-o-usuario
ADMINISTRATIVO_DB_PASSWORD=troque-a-senha

# MySQL do ms-agendamento (o root só é usado pelo healthcheck do container)
AGENDAMENTO_DB_USER=troque-o-usuario
AGENDAMENTO_DB_PASSWORD=troque-a-senha
AGENDAMENTO_DB_ROOT_PASSWORD=troque-a-senha-do-root

# PostgreSQL do Keycloak
KEYCLOAK_DB_USER=troque-o-usuario
KEYCLOAK_DB_PASSWORD=troque-a-senha

# RabbitMQ (eventos do ms-administrativo). Painel: http://localhost:15672
RABBITMQ_USER=troque-o-usuario
RABBITMQ_PASSWORD=troque-a-senha

# Keycloak: administrador do console (realm master), http://localhost:8180
KEYCLOAK_ADMIN=troque-o-usuario
KEYCLOAK_ADMIN_PASSWORD=troque-a-senha

# Keycloak: realm "clinical" (keycloak/realm-clinical.json lê estes valores no import)
# Senha do usuário "admin" do realm, que usa a API (mínimo 8 caracteres)
KEYCLOAK_CLINICAL_ADMIN_PASSWORD=troque-a-senha
# Segredos dos clients (client credentials). Gere valores longos e aleatórios, ex.: openssl rand -hex 32
KEYCLOAK_ADMINISTRATIVO_SECRET=troque-o-segredo
KEYCLOAK_AGENDAMENTO_SECRET=troque-o-segredo
#
# O realm só é importado na PRIMEIRA subida do Keycloak (volume vazio). Para trocar estes valores num Keycloak
# que já existe, troque também no console (Clients > Credentials, Users > Credentials) ou recrie o volume.
